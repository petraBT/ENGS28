<?xml version="1.0" encoding="UTF-8"?>

<!-- Publication file for ENGS 28: Embedded Systems                       -->
<!-- Styled to match the C-Programming (ENGS 20) book.                   -->
<!-- For full documentation see:                                          -->
<!-- https://pretextbook.org/doc/guide/html/publisher-file-reference.html -->

<publication>
    <common>
        <!-- Level at which HTML files are generated -->
        <chunking level="3" />
        <!-- Depth for table of contents -->
        <tableofcontents level="3" />
        <!-- Visibility of exercise components -->
        <exercise-inline statement="yes" hint="yes" answer="no" solution="no" />
        <exercise-divisional statement="yes" hint="yes" answer="no" solution="no"/>
        <exercise-reading statement="yes" hint="yes" answer="no" solution="no"/>
        <exercise-project statement="yes" hint="yes" answer="no" solution="no"/>
        <!-- Style of fill-in-the-blanks -->
        <fillin textstyle="underline" mathstyle="shade" />
    </common>

    <source>
        <directories external="../assets" generated="../generated-assets"/>
    </source>

    <numbering>
        <blocks level="2"/>
        <projects level="2"/>
        <equations level="2"/>
        <footnotes level="2"/>
    </numbering>

    <latex print="no" sides="one" font-size="10" draft="no">
        <page right-alignment="flush" bottom-alignment="ragged">
            <geometry>paper=letterpaper, width=.9\paperwidth</geometry>
        </page>
        <asymptote links="no" />
        <worksheets formatted="yes" />
    </latex>

    <html short-answer-responses="always" favicon="simple">
        <platform host="web"/>
        <knowl
            theorem="no"
            proof="yes"
            definition="no"
            example="yes"
            example-solution="yes"
            project="no"
            task="no"
            remark="no"
            objectives="no"
            outcomes="no"
            figure="no"
            table="no"
            listing="no"
            list="no"
            exercise-inline="yes"
            exercise-divisional="no"
            exercise-worksheet="no"
            exercise-readingquestion="no"
        />
        <!-- Same theme and palette as the C-Programming book -->
        <css theme="denver" palette="leaves"/>
        <search variant="default"/>
        <feedback href="mailto:petra.bonfert-taylor@dartmouth.edu">
            <text>Report Errors</text>
        </feedback>
    </html>

</publication>
