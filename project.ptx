<?xml version="1.0" encoding="utf-8"?>
<!-- This file was automatically generated by PreTeXt 2.43.0. -->
<!-- If you modify this file, PreTeXt will no longer automatically update it.-->

<!-- This file, the project manifest, provides the overall configuration for your PreTeXt project. To edit the content of your document, open `source/main.ptx`. See https://pretextbook.org/doc/guide/html/processing-CLI.html#cli-project-manifest. -->
<project ptx-version="2">
  <targets>
    <!-- All HTML/print targets use the custom stylesheets so PreTeXt knows the
         <slide> element (the condensed in-class projector form of a piece of
         content, authored beside its full prose - see xsl/engs28-html.xsl).
         By default <slide> blocks are STRIPPED: the reading book shows the full
         prose, never the condensed form, and never the instructor-only notes or
         solutions a slide may inline. Only the "web-deck" target renders them
         (as hidden <div>s the classroom deck player extracts). -->
    <!-- The reading book, and THE TARGET `pretext deploy` PUBLISHES.
         It renders <slide> blocks (deck.slides=render) for one reason: the
         deck player, external/class.html, extracts a slide out of the book
         page named in the deck JSON. assets/ is copied into every target, so
         the player and the deck lists were already on the published site,
         but the pages beside them had no slides in them. 498 of the 945
         slides (53%, every one backed by a <slide> rather than an activity
         or a figure) failed with "Slide … not found" for anyone opening the
         deployed decks.
         Rendering them here costs about 4 kB a page and nothing visually:
         the divs carry `hidden` and external/deck.css keeps them out of the
         reading view, exactly as in web-deck.
         Instructor slides are still NOT rendered. deck.solutions is unset,
         so the XSL strips them before the HTML, as it always did here. -->
    <target name="web" format="html" xsl="engs28-html.xsl">
      <stringparams html.css.extra="external/deck.css external/book.css" deck.slides="render" />
    </target>
    <target name="print" format="pdf" xsl="engs28-latex.xsl" />
    <!-- Authoring build: "web" plus the click-to-source helper, assets/ptx-edit.js.
         Alt-click any paragraph to open it in your editor; alt-shift-click to edit
         its text in place. Requires scripts/edit-server.py to be running - use
         ./preview-edit.sh, which starts both. See scripts/README-editing.md.
         Local only, and deliberately so: this is the one target carrying a script
         that talks to a server able to rewrite source files, so it is kept out of
         build.sh. -->
    <target name="web-edit" format="html" xsl="engs28-html.xsl">
      <!-- PreTeXt copies everything under assets/ into <output-dir>/external/,
           so this resolves without any extra build step. -->
      <stringparams html.js.extra="external/ptx-edit.js" html.css.extra="external/book.css" />
    </target>
    <!-- Instructor build: the reading "web" content PLUS every <instructor>
         block (book.solutions=render), boxed and labelled. This is the only
         target in which a worked solution appears at all - in every other one
         the block is stripped before it reaches the HTML, so it is not in the
         student book's page source either. Build it into its own directory and
         do not deploy it beside the student book. -->
    <target name="web-instructor" format="html" xsl="engs28-html.xsl">
      <stringparams html.css.extra="external/book.css" book.solutions="render" />
    </target>
    <!-- Classroom-deck build: <slide> blocks RENDERED as hidden
         <div class="deck-slide"> (deck.slides=render) plus the CSS that keeps
         them out of the reading view (assets/deck.css -> external/deck.css).
         The deck player (external/class.html) extracts those hidden blocks by
         xml:id.
         Since 2026-09-25 this is byte-for-byte what "web" above also produces,
         because the published site needs a working player too. It is kept as a
         separate target because two things build it into their own directory
         and expect it there: scripts/build-deck.sh (which also filters the deck
         lists) and make-slide-pdfs.sh, which prints handouts from it while you
         may be serving something else out of output/web. If you ever make the
         two differ, make_slide_pdfs and the published decks will differ too. -->
    <target name="web-deck" format="html" xsl="engs28-html.xsl">
      <stringparams html.css.extra="external/deck.css external/book.css" deck.slides="render" />
    </target>
    <!-- The deck you TEACH from: web-deck plus the instructor-only slides
         (deck.solutions=render) and the <instructor> blocks a slide may ref
         directly (book.solutions=render). web-deck above is the student deck -
         it strips both, so an answer is not in its page source even though the
         player would have hidden it anyway. preview-slides.sh and the Launchpad
         slide tiles all build THIS one; web-deck is what you would publish. -->
    <target name="web-deck-instructor" format="html" xsl="engs28-html.xsl">
      <stringparams html.css.extra="external/deck.css external/book.css" deck.slides="render" deck.solutions="render" book.solutions="render" />
    </target>
  </targets>
</project>


